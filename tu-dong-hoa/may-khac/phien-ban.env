# PHIÊN BẢN KHOÁ CỦA CÔNG CỤ DỰNG VIDEO — đo trên Mac chính 20/11/2026. Mọi máy cài đúng các bản này để video ra giống nhau.
# cai-cong-cu-video.sh cài theo file này; kiem-may.sh so máy đang chạy với file này.
# Đổi bản (nâng cấp) chỉ làm trên Mac chính: cài bản mới, dựng thử, sửa số ở đây, đẩy GitHub; các máy khác chạy lại cai-cong-cu-video.sh.
# Remotion, React, font chữ khoá trong package.json + package-lock.json của hai khuôn dựng (khuon-remotion, khuon-dung-ghep).

FFMPEG=9.0            # Mac: brew ffmpeg (9.0.2); Linux: bản dựng sẵn BtbN nhánh n9.0
WHISPER_CPP=1.9.5     # Mac: brew whisper-cpp; Linux: dựng từ mã nguồn thẻ v1.9.5
NODE=24.18.0          # qua nvm, mọi máy
NVM=0.40.3
PYTHON=3.12           # qua uv: môi trường pyannote, dò mặt (máy khác)
PILLOW=13.0.0         # python3 hệ thống (script gọi python3 -I)
NUMPY=2.5.4           # môi trường podcast-venv
TORCH=2.8.0
TORCHAUDIO=2.8.0
PYANNOTE_AUDIO=3.4.0
MEDIAPIPE=0.10.21     # chỉ máy không phải Mac (dò mặt thay Vision)
OPENCV=4.11.0.86
REMOTION=4.0.545
GDOWN=6.5.2           # tải file / thư mục Google Drive David gửi link (uv tool)
YT_DLP=2026.10.26     # tải video YouTube / TikTok (chỉ để học mẫu hoặc video của chính David)

# Mô hình (mã kiểm sha256)
WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
WHISPER_MODEL_SHA=1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69
YUNET_URL=https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
YUNET_SHA=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
LANDMARK_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
LANDMARK_SHA=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff
