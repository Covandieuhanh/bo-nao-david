{
 "type": "object",
 "required": [
  "loc",
  "cat",
  "de_xuat_dung",
  "loai_video"
 ],
 "properties": {
  "loc": {
   "type": "object",
   "required": [
    "ket_luan",
    "diem",
    "ly_do",
    "nhanh",
    "de_xuat",
    "ba_phan",
    "cau_mo"
   ],
   "properties": {
    "ket_luan": {
     "type": "string",
     "description": "một trong 7 nhãn: ⭐ Rất tốt · ✅ Phù hợp · ✂️ Trích ngắn từ gốc · 🔁 Trùng / dư · 🗂 Lưu kho · 👤 Chỉ Facebook cá nhân · ⛔ Không làm"
    },
    "diem": {
     "type": "object",
     "required": [
      "goc",
      "tep",
      "hanh_dong",
      "tuong_tac",
      "nhan_hieu"
     ],
     "properties": {
      "goc": {
       "type": "integer"
      },
      "tep": {
       "type": "integer"
      },
      "hanh_dong": {
       "type": "integer"
      },
      "tuong_tac": {
       "type": "integer"
      },
      "nhan_hieu": {
       "type": "integer"
      }
     }
    },
    "ly_do": {
     "type": "string"
    },
    "lan_ranh": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "trich",
       "rui_ro"
      ],
      "properties": {
       "trich": {
        "type": "string"
       },
       "rui_ro": {
        "type": "string"
       }
      }
     }
    },
    "nhanh": {
     "type": "string"
    },
    "de_xuat": {
     "type": "string"
    },
    "ba_phan": {
     "type": "object",
     "properties": {
      "van_de": {
       "type": "string"
      },
      "giai_phap": {
       "type": "string"
      },
      "thuc_thi": {
       "type": "string"
      }
     }
    },
    "cau_mo": {
     "type": "string"
    },
    "hoi": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "cat": {
   "type": "object",
   "required": [
    "giu_de_xuat"
   ],
   "properties": {
    "giu_de_xuat": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "số # các đề xuất cắt của máy được giữ"
    },
    "bo_truoc": {
     "type": "string",
     "description": "câu nguyên văn: cắt hết mọi thứ TRƯỚC câu này (trống = không)"
    },
    "bo_sau": {
     "type": "string",
     "description": "câu nguyên văn: cắt hết mọi thứ SAU câu này (trống = không)"
    },
    "ly_do": {
     "type": "string"
    },
    "orient": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "180",
       "cw",
       "ccw",
       "mirror"
      ]
     },
     "description": "sửa chiều hình theo orient.jpg; [] = đúng chiều"
    },
    "khung_trong": {
     "type": "string",
     "description": "video cũ có chữ/viền in cứng: khung giữ lại 'rộng:cao:x:y' (pixel khung gốc, cùng tỉ lệ khung); trống = không cắt"
    }
   }
  },
  "de_xuat_dung": {
   "type": "object",
   "required": [
    "cau_chot",
    "y_chinh"
   ],
   "properties": {
    "cau_chot": {
     "type": "string",
     "description": "câu nguyên văn cuối video dùng cho màn chốt (câu kêu gọi/giao việc); trống nếu không có"
    },
    "y_chinh": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "2–5 ý chính sẽ minh hoạ, mỗi ý một dòng ngắn"
    },
    "chu_thumbnail": {
     "type": "string",
     "description": "video ngang: 'DÒNG 1 / DÒNG 2' trích lời, ≤ 8 chữ"
    }
   }
  },
  "phan_hoi": {
   "type": "string",
   "description": "chỉ khi có GÓP Ý CỦA DAVID: 1–2 câu cho David biết đã sửa gì"
  },
  "loai_video": {
   "type": "object",
   "required": [
    "loai",
    "ly_do"
   ],
   "properties": {
    "loai": {
     "type": "string",
     "enum": [
      "noi-truoc-camera",
      "vlog-canh",
      "podcast-tieng",
      "khac"
     ]
    },
    "ly_do": {
     "type": "string"
    }
   },
   "description": "loại video THẬT nhìn từ hình + lời: 1 người nói trước camera · vlog/cảnh sự kiện (ít nói trước camera) · podcast chỉ tiếng · khác"
  }
 }
}